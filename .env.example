# --- AI providers ------------------------------------------------------------
# Add a key for every provider you want to use; leave the others empty.
# OpenRouter:  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Google AI Studio (Gemini):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:  https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras:  https://cloud.cerebras.ai  (API Keys)
CEREBRAS_API_KEY=
# Mistral:  https://console.mistral.ai/api-keys  (free "Experiment" plan)
MISTRAL_API_KEY=
# Ollama (local models, free and unlimited): https://ollama.com/download
# Use models as "ollama:<name>" (e.g. ollama:gemma4:26b-a4b) after `ollama pull <name>`.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# Context window per call; books need a large one (Ollama's own default is much smaller).
OLLAMA_NUM_CTX=32768
# Max seconds per local call (large models on a CPU can need over an hour per chapter segment).
OLLAMA_TIMEOUT_SECONDS=14400
# Let "thinking" models reason before answering (much slower, rarely better prose).
OLLAMA_THINK=false

# --- Models ------------------------------------------------------------------
# Comma-separated fallback chains of "provider:model". No prefix = OpenRouter.
# Each request tries the models in order and moves on when a provider is rate-limited,
# out of quota or down. The writer is pinned per book once its first part is written.
# Model ids change often: copy current ones from Settings -> Models in the app.
#
# Example free setup (check the ids in Settings -> Models first):
# WRITER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free, groq:openai/gpt-oss-120b, cerebras:gpt-oss-120b
# EDITOR_MODELS=gemini:gemini-flash-latest, mistral:mistral-small-latest, google/gemma-4-31b-it:free
WRITER_MODELS=anthropic/claude-sonnet-5.5
EDITOR_MODELS=anthropic/claude-haiku-5.5
# Cover art uses OpenRouter image models only.
IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Database (Docker Postgres) --------------------------------------------
# Used when running the API/worker on your machine. docker compose overrides it for containers.
DATABASE_URL=postgresql+psycopg://bookpilot:bookpilot@localhost:5442/bookpilot

# --- Quality assurance -----------------------------------------------------
LANGUAGETOOL_URL=http://localhost:8010
# Optional: path to epubcheck.jar (bundled in the Docker image) to validate EPUBs.
EPUBCHECK_JAR=

# --- Slack notifications (optional, off by default) -------------------------
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Local development ------------------------------------------------------
# Run background jobs inside the API process instead of a separate worker.
RUN_WORKER_IN_PROCESS=false
